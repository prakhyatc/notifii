# ─────────────────────────────────────────────────────────────
# Notifii Configuration
# Copy to .env and customize:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Queue ────────────────────────────────────────────────────
# Backend: redis | sqs | memory
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# ── Email Provider ───────────────────────────────────────────
# Provider: console | smtp | resend | ses
EMAIL_PROVIDER=console

# SMTP (for Mailhog local dev or real SMTP relay)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@notifii.dev

# Resend (https://resend.com — free tier: 3000 emails/mo)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# ── Idempotency ─────────────────────────────────────────────
# Backend: redis | memory
IDEMPOTENCY_BACKEND=redis

# ── Application ─────────────────────────────────────────────
APP_ENV=dev
DEMO_MODE=true
RATE_LIMIT_PER_MIN=60

# ── Worker ──────────────────────────────────────────────────
POLL_WAIT_SECONDS=5
MAX_BATCH=10

# ── Tracing (OpenTelemetry) ──────────────────────────────────
# Enable distributed tracing (requires Jaeger or OTLP-compatible backend)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME is set per service in docker-compose

# ── AWS (only needed for SQS/SES backends) ──────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NOTIFII_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/notifii-queue
